+    int profile_out_allocated, profile_out_min, profile_out_actual;
+    uint64_t profile_output_reconfigs;
 } OMXCodecDecoderContext;
 
+static inline void omx_profile_add(OMXCodecDecoderContext *s, enum OMXProfileStage stage, int64_t begin)
+{
+    int64_t elapsed = av_gettime_relative() - begin;
+    OMXProfileTimer *timer = &s->profile_timers[stage];
+    if (elapsed < 0)
+        elapsed = 0;
+    timer->calls++;
+    timer->total_us += elapsed;
+    if ((uint64_t)elapsed > timer->max_us)
+        timer->max_us = elapsed;
+}
+
+static inline void omx_profile_window(OMXCodecDecoderContext *s)
+{
+    int upper = atomic_load_explicit(&s->profile_upper_snapshot, memory_order_relaxed);
+    int packets = s->pkt_sent_num;
+    if (!s->profile_window_seen) {
+        s->profile_pkt_min = s->profile_pkt_max = packets;
+        s->profile_upper_min = s->profile_upper_max = upper;
+        s->profile_window_seen = true;
+    }
+    s->profile_pkt_min = FFMIN(s->profile_pkt_min, packets);
+    s->profile_pkt_max = FFMAX(s->profile_pkt_max, packets);
+    s->profile_upper_min = FFMIN(s->profile_upper_min, upper);
+    s->profile_upper_max = FFMAX(s->profile_upper_max, upper);
+    s->profile_pkt_last = packets;
+    s->profile_upper_last = upper;
+}
+
+static void omx_profile_report(OMXCodecDecoderContext *s)
+{
+    static const char *const names[OMX_PROF_COUNT] = {
+        "receive_total", "input_buffer_wait", "input_memcpy", "input_EmptyThisBuffer",
+        "buffer_control_wait", "port_GetParameter", "output_buffer_get",
+        "ff_get_buffer", "output_wrap", "ff_decode_get_packet", "retained_output_FillThisBuffer"
+    };
+    OMXProfileTimer timers[OMX_PROF_COUNT];
+    int out_allocated, out_min, out_actual;
+    uint64_t reconfigs;
+    unsigned i;
+    if (!s->profile_timers[OMX_PROF_RECEIVE].calls && !s->profile_init_in_actual)
+        return;
+    // FreeHandle has completed, and this is the final decoder reference. Keep
+    // the original per-path locks for snapshots too: no partially read refill
+    // timer or allocation metadata if a component callback is still unwinding.
+    if (s->mutex_cond_inited)
+        pthread_mutex_lock(&s->free_mutex);
+    memcpy(timers, s->profile_timers, sizeof(timers));
+    if (s->mutex_cond_inited)
+        pthread_mutex_unlock(&s->free_mutex);
+    if (s->mutex_cond_inited)
+        pthread_mutex_lock(&s->output_mutex);
+    out_allocated = s->profile_out_allocated;
+    out_min = s->profile_out_min;
+    out_actual = s->profile_out_actual;
+    reconfigs = s->profile_output_reconfigs;
+    if (s->mutex_cond_inited)
+        pthread_mutex_unlock(&s->output_mutex);
+    av_log(NULL, AV_LOG_INFO,
+           "OMX profile buffers: in_min=%d in_actual=%d in_allocated=%d out_init_min=%d out_init_actual=%d out_allocated=%d out_min=%d out_actual=%d upper_init=%d output_reconfigs=%"PRIu64"\n",
+           s->profile_init_in_min, s->profile_init_in_actual, s->profile_in_allocated,
+           s->profile_init_out_min, s->profile_init_out_actual, out_allocated, out_min, out_actual,
+           s->profile_init_upper, reconfigs);
+    av_log(NULL, AV_LOG_INFO,
+           "OMX profile loop: calls=%"PRIu64" loops=%"PRIu64" loops_max=%"PRIu64" pending_no_send=%"PRIu64" pkt_min=%d pkt_max=%d pkt_last=%d upper_min=%d upper_max=%d upper_last=%d input_bytes=%"PRIu64" input_unavailable=%"PRIu64" output_empty=%"PRIu64"\n",
+           timers[OMX_PROF_RECEIVE].calls, s->profile_loops, s->profile_loop_max, s->profile_pending_no_send,
+           s->profile_pkt_min, s->profile_pkt_max, s->profile_pkt_last,
+           s->profile_upper_min, s->profile_upper_max, s->profile_upper_last,
+           s->profile_input_bytes, s->profile_input_unavailable, s->profile_output_empty);
+    for (i = 0; i < OMX_PROF_COUNT; i++) {
+        OMXProfileTimer *t = &timers[i];
+        av_log(NULL, AV_LOG_INFO, "OMX profile stage=%s calls=%"PRIu64" total_us=%"PRIu64" avg_us=%.3f max_us=%"PRIu64"\n",
+               names[i], t->calls, t->total_us, t->calls ? (double)t->total_us / t->calls : 0.0, t->max_us);
+    }
+}
