+// Diagnostic aggregates only. Except for retained-output refill (free_mutex)
+// and output allocation snapshots (output_mutex), these are decoder-thread
+// owned. The decoder's last reference runs cleanup after API/frame users exit.
+typedef struct OMXProfileTimer {
+    uint64_t calls;
+    uint64_t total_us;
+    uint64_t max_us;
+} OMXProfileTimer;
