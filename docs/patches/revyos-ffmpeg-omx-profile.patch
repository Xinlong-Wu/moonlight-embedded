+    bool profile_window_seen;
+    int profile_pkt_min, profile_pkt_max, profile_pkt_last;
+    int profile_upper_min, profile_upper_max, profile_upper_last;
+    atomic_int profile_upper_snapshot;
+    int profile_init_in_min, profile_init_in_actual, profile_init_out_min, profile_init_out_actual;
+    int profile_init_upper, profile_in_allocated;
